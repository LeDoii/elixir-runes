{
  // Worker "elixir-runes" : sert le site (dossier docs) et l'API des codes courts (/api/*).
  "name": "elixir-runes",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    // Le Worker n'est appelé que pour l'API ; le reste du site est servi directement comme fichiers statiques.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elixir-runes",
      "database_id": "24971e7d-b6ec-4233-8890-428f0e6cd3fc"
    }
  ]
}
